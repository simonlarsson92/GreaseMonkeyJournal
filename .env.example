# Grease Monkey Journal Environment Variables Template
# Copy this file to .env and update the values for your environment

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=greasemonkey_journal
MYSQL_USER=appuser
MYSQL_PASSWORD=your_secure_app_password_here

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
APP_TITLE=Grease Monkey Journal

# Email Notification Configuration
# For Development: Use MailDev (catches all emails, no real sending)
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@greasemonkey.local
SMTP_FROM_NAME=Grease Monkey Journal

# For Production: Use Gmail (example)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_ENABLE_SSL=true
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=Grease Monkey Journal

# Alternative: Outlook/Hotmail SMTP settings
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@outlook.com
# SMTP_PASSWORD=your-password

# Connection String Components (used to build the full connection string)
DB_SERVER=mariadb
DB_PORT=3306
DB_CONNECTION_TIMEOUT=30
DB_COMMAND_TIMEOUT=60

# Seq Logging Configuration
SEQ_URL=http://seq:80
SEQ_API_KEY=

# Security Note: 
# 1. Never commit .env files to version control
# 2. Use strong, unique passwords
# 3. Consider using Docker secrets for production environments
# 4. SEQ_API_KEY is optional for development but recommended for production
