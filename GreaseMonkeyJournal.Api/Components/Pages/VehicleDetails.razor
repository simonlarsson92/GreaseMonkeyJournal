@page "/vehicle/{VehicleId:int}"
@using GreaseMonkeyJournal.Api.Components.Models
@using GreaseMonkeyJournal.Api.Components.Services

<PageTitle>Vehicle Details</PageTitle>

<div class="container-fluid">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (vehicle == null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>Vehicle not found.
        </div>
    }
    else
    {
        <!-- Vehicle summary -->
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">@vehicle.Make @vehicle.Model</h5>
                            <div class="d-flex gap-2">
                                <a href="/vehicle/@vehicle.Id/logs" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-journal-text me-1"></i>Logs
                                </a>
                                <a href="/vehicle/@vehicle.Id/reminders" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-bell me-1"></i>Reminders
                                </a>
                                <a href="/edit-vehicle/@vehicle.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Type</div>
                                <div>@vehicle.VehicleType.ToDisplayName()</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Year</div>
                                <div>@vehicle.Year</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">@(vehicle.VehicleType == VehicleType.TractorImplement ? "Serial Number" : "Registration")</div>
                                <div>@IdentifierValue()</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Speedometer</div>
                                <div>@GetSpeedometerLabel(vehicle.SpeedometerType)</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(vehicle.Description))
                            {
                                <div class="col-12">
                                    <div class="text-muted small">Description</div>
                                    <div style="white-space:pre-wrap">@vehicle.Description</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Information cards -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-card-list me-2"></i>Information (@cards.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (cards.Any())
                        {
                            <div class="row g-3 mb-4">
                                @foreach (var card in cards)
                                {
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <div class="card h-100">
                                            <div class="card-header d-flex justify-content-between align-items-center">
                                                <strong>@card.Title</strong>
                                                <div class="d-flex gap-1">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(card)" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCardAsync(card)" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <p class="mb-0" style="white-space:pre-wrap">@card.Details</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                <i class="bi bi-info-circle me-2"></i>
                                No information cards yet. Add one below (e.g. an article number, oil type, or part reference).
                            </div>
                        }

                        <hr class="my-4" />

                        <h6>@(IsEditing ? "Edit Information Card" : "Add Information Card")</h6>
                        <EditForm Model="editModel" OnValidSubmit="SaveCardAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="cardTitle" class="form-label">Title *</label>
                                    <input type="text" class="form-control" id="cardTitle" @bind="editModel.Title" maxlength="100" required />
                                </div>
                                <div class="col-md-8">
                                    <label for="cardDetails" class="form-label">Details</label>
                                    <textarea class="form-control" id="cardDetails" rows="3" maxlength="2000" @bind="editModel.Details"></textarea>
                                </div>
                                <div class="col-12 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi @(IsEditing ? "bi-check-circle" : "bi-plus-circle") me-2"></i>@(IsEditing ? "Save Changes" : "Add Card")
                                    </button>
                                    @if (IsEditing)
                                    {
                                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                                    }
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showSuccessMessage)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="() => showSuccessMessage = false"></button>
            </div>
            <div class="toast-body">
                @successMessage
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int VehicleId { get; set; }
    [Inject] private IVehicleService VehicleService { get; set; } = default!;
    [Inject] private IVehicleInfoCardService InfoCardService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private Vehicle? vehicle;
    private List<VehicleInfoCard> cards = new();
    private VehicleInfoCard editModel = new();
    private bool isLoading = true;
    private bool showSuccessMessage = false;
    private string successMessage = "";

    private bool IsEditing => editModel.Id > 0;

    protected override async Task OnInitializedAsync()
    {
        vehicle = await VehicleService.GetByIdAsync(VehicleId);
        if (vehicle != null)
        {
            cards = await InfoCardService.GetByVehicleIdAsync(VehicleId);
        }
        isLoading = false;
    }

    private string IdentifierValue()
    {
        if (vehicle == null) return "N/A";
        var value = vehicle.GetIdentifier();
        return string.IsNullOrWhiteSpace(value) ? "N/A" : value;
    }

    private void StartEdit(VehicleInfoCard card)
    {
        editModel = new VehicleInfoCard
        {
            Id = card.Id,
            VehicleId = card.VehicleId,
            Title = card.Title,
            Details = card.Details
        };
    }

    private void CancelEdit()
    {
        editModel = new VehicleInfoCard();
    }

    private async Task SaveCardAsync()
    {
        if (string.IsNullOrWhiteSpace(editModel.Title))
            return;

        editModel.VehicleId = VehicleId;

        if (editModel.Id > 0)
        {
            await InfoCardService.UpdateAsync(editModel);
            successMessage = "Information card updated successfully!";
        }
        else
        {
            await InfoCardService.AddAsync(editModel);
            successMessage = "Information card added successfully!";
        }

        editModel = new VehicleInfoCard();
        cards = await InfoCardService.GetByVehicleIdAsync(VehicleId);
        await ShowSuccessAsync();
    }

    private async Task DeleteCardAsync(VehicleInfoCard card)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete information card \"{card.Title}\"?");
        if (!confirmed)
            return;

        await InfoCardService.DeleteAsync(card.Id);
        if (editModel.Id == card.Id)
            editModel = new VehicleInfoCard();
        cards = await InfoCardService.GetByVehicleIdAsync(VehicleId);
        successMessage = "Information card deleted.";
        await ShowSuccessAsync();
    }

    private async Task ShowSuccessAsync()
    {
        showSuccessMessage = true;
        StateHasChanged();
        await Task.Delay(3000);
        showSuccessMessage = false;
        StateHasChanged();
    }

    private string GetSpeedometerLabel(SpeedometerType speedometerType) => speedometerType switch
    {
        SpeedometerType.KM => "Kilometers",
        SpeedometerType.Hours => "Hours",
        SpeedometerType.None => "None",
        _ => "Unknown"
    };
}
