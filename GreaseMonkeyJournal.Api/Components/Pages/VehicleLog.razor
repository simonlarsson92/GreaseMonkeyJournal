@page "/vehicle/{vehicleId:int}/logs"
@page "/vehicle/logs"
@using GreaseMonkeyJournal.Api.Components.Models
@using GreaseMonkeyJournal.Api.Components.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Vehicle Log Entries</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Log Entries</h5>
                        <button type="button" class="btn btn-primary" @onclick="ShowAddDialog">
                            <i class="bi bi-plus-circle me-2"></i>Add Log Entry
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (logEntries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th role="button" @onclick="() => SortBy(nameof(LogEntry.Date))">Date <i class="bi @GetSortIcon(nameof(LogEntry.Date))"></i></th>
                                        <th role="button" @onclick="() => SortBy(VehicleColumn)">Vehicle <i class="bi @GetSortIcon(VehicleColumn)"></i></th>
                                        <th role="button" @onclick="() => SortBy(nameof(LogEntry.Description))">Description <i class="bi @GetSortIcon(nameof(LogEntry.Description))"></i></th>
                                        <th role="button" @onclick="() => SortBy(nameof(LogEntry.Type))">Type <i class="bi @GetSortIcon(nameof(LogEntry.Type))"></i></th>
                                        <th role="button" @onclick="() => SortBy(nameof(LogEntry.Cost))">Cost <i class="bi @GetSortIcon(nameof(LogEntry.Cost))"></i></th>
                                        <th role="button" @onclick="() => SortBy(ReadingColumn)">Reading <i class="bi @GetSortIcon(ReadingColumn)"></i></th>
                                        <th role="button" @onclick="() => SortBy(nameof(LogEntry.Notes))">Notes <i class="bi @GetSortIcon(nameof(LogEntry.Notes))"></i></th>
                                        <th></th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in PagedEntries)
                                    {
                                        <tr>
                                            <td>@entry.Date?.ToShortDateString()</td>
                                            <td>@entry.Vehicle?.Make @entry.Vehicle?.Model @(entry.Vehicle?.GetIdentifierParenthetical())</td>
                                            <td>@entry.Description</td>
                                            <td>
                                                <span class="badge @(entry.Type == "repair" ? "bg-warning" : "bg-success")">
                                                    @entry.Type
                                                </span>
                                            </td>
                                            <td>@FormatCurrency(entry.Cost)</td>
                                            <td>@GetSpeedometerReadingDisplay(entry)</td>
                                            <td>@entry.Notes</td>
                                            <td>
                                                @if (entry.Attachments.Any())
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => ShowAttachmentsModal(entry)">
                                                        <span class="badge bg-secondary">
                                                            <i class="bi bi-paperclip"></i> @entry.Attachments.Count
                                                        </span>
                                                    </button>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditDialog(entry)">
                                                    <i class="bi bi-pencil me-1"></i>Edit
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (TotalPages > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <small class="text-muted">
                                    Showing @PageStart&ndash;@PageEnd of @logEntries.Count() entries
                                </small>
                                <nav aria-label="Log entries pagination">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="PreviousPage">Previous</button>
                                        </li>
                                        <li class="page-item disabled">
                                            <span class="page-link">@_currentPage / @TotalPages</span>
                                        </li>
                                        <li class="page-item @(_currentPage == TotalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="NextPage">Next</button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            No log entries found. Click "Add Log Entry" to create your first entry.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showDialog)
{
    <AddLogEntryDialog
        @ref="dialogComponent"
        LogEntry="selectedEntry"
        VehicleId="@(vehicleId ?? 0)"
        OnLogEntryAdded="HandleLogEntrySubmission"
        OnClosed="HandleDialogClosed" />
}

@if (showAttachmentsModal && attachmentViewEntry != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-paperclip me-2"></i>Attachments</h5>
                    <button type="button" class="btn-close" @onclick="CloseAttachmentsModal"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var att in attachmentViewEntry.Attachments)
                        {
                            <li class="list-group-item px-0">
                                <a href="/api/attachments/@att.Id" target="_blank" class="d-flex align-items-center gap-2">
                                    <i class="bi @GetAttachmentIcon(att.ContentType)"></i>
                                    <span class="text-truncate">@att.FileName</span>
                                    <small class="text-muted ms-auto text-nowrap">@FormatFileSize(att.FileSizeBytes)</small>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAttachmentsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showSuccessMessage)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="() => showSuccessMessage = false"></button>
            </div>
            <div class="toast-body">
                @successMessage
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? vehicleId { get; set; }
    [Inject] private ILogEntryService LogEntryService { get; set; } = default!;
    [Inject] private ILogAttachmentService AttachmentService { get; set; } = default!;
    [Inject] private IVehicleService VehicleService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IUserSettingsService UserSettingsService { get; set; } = default!;

    private const string VehicleColumn = "Vehicle";
    private const string ReadingColumn = "Reading";
    private const int PageSize = 25;

    private IEnumerable<LogEntry> logEntries = new List<LogEntry>();
    private IEnumerable<LogEntry> sortedEntries => ApplySort(logEntries);
    private IEnumerable<LogEntry> PagedEntries => sortedEntries.Skip((_currentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => (int)Math.Ceiling(logEntries.Count() / (double)PageSize);
    private int PageStart => logEntries.Any() ? (_currentPage - 1) * PageSize + 1 : 0;
    private int PageEnd => Math.Min(_currentPage * PageSize, logEntries.Count());

    private int _currentPage = 1;
    private string sortColumn = nameof(LogEntry.Date);
    private bool sortAscending = false;
    private bool IsSingleMode => vehicleId.HasValue;
    private bool showDialog = false;
    private bool showAttachmentsModal = false;
    private LogEntry? attachmentViewEntry;
    private bool showSuccessMessage = false;
    private string successMessage = "";
    private AddLogEntryDialog? dialogComponent;
    private LogEntry? selectedEntry;
    private string currencyCode = "USD";
    private static readonly Dictionary<string, string> CurrencyCultureMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["USD"] = "en-US",
        ["EUR"] = "de-DE",
        ["GBP"] = "en-GB",
        ["SEK"] = "sv-SE"
    };

    protected override async Task OnInitializedAsync()
    {
        logEntries = await GetLogEntriesAsync();
        currencyCode = await UserSettingsService.GetCurrencyCodeAsync();
    }

    private async Task ShowAddDialog()
    {
        selectedEntry = null;
        showDialog = true;
        StateHasChanged();
        await Task.Yield();
        if (dialogComponent != null)
        {
            await dialogComponent.ShowModal();
        }
    }
    private async Task ShowEditDialog(LogEntry entry)
    {
        selectedEntry = new LogEntry
        {
            Id = entry.Id,
            VehicleId = entry.VehicleId,
            Date = entry.Date,
            Description = entry.Description,
            Cost = entry.Cost,
            Type = entry.Type,
            Notes = entry.Notes,
            SpeedometerReading = entry.SpeedometerReading,
            Attachments = entry.Attachments
        };

        showDialog = true;
        StateHasChanged();
        await Task.Yield();
        if (dialogComponent != null)
        {
            await dialogComponent.ShowModal();
        }
    }

    private async Task HandleLogEntrySubmission(LogEntrySubmission submission)
    {
        var entry = submission.Entry;
        if (entry.Id > 0)
        {
            await LogEntryService.UpdateAsync(entry);
            successMessage = "Log entry updated successfully!";
        }
        else
        {
            await LogEntryService.AddAsync(entry);
            successMessage = "Log entry created successfully!";
        }

        foreach (var id in submission.AttachmentIdsToDelete)
            await AttachmentService.DeleteAsync(id);

        foreach (var file in submission.NewFiles)
            await AttachmentService.SaveAsync(entry.Id, file);

        logEntries = await GetLogEntriesAsync();
        _currentPage = 1;
        showSuccessMessage = true;
        StateHasChanged();
        await Task.Delay(3000);
        showSuccessMessage = false;
        StateHasChanged();
    }

    private void HandleDialogClosed()
    {
        showDialog = false;
        selectedEntry = null;
        StateHasChanged();
    }

    private async Task<IEnumerable<LogEntry>> GetLogEntriesAsync()
    {
        if (IsSingleMode)
            return await LogEntryService.GetByVehicleIdAsync(vehicleId!.Value);
        else
            return await LogEntryService.GetAllAsync();
    }

    private string GetSpeedometerReadingDisplay(LogEntry logEntry)
    {
        if (logEntry.Vehicle == null || logEntry.Vehicle.SpeedometerType == SpeedometerType.None)
            return "N/A";
        if (logEntry.SpeedometerReading.HasValue)
        {
            var unit = logEntry.Vehicle.SpeedometerType == SpeedometerType.KM ? "km" : "h";
            return $"{logEntry.SpeedometerReading:N0} {unit}";
        }
        return "N/A";
    }

    private string FormatCurrency(decimal amount)
    {
        if (!CurrencyCultureMap.TryGetValue(currencyCode, out var cultureName))
            cultureName = "en-US";

        return amount.ToString("C", CultureInfo.GetCultureInfo(cultureName));
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        _currentPage = 1;
    }

    private void PreviousPage()
    {
        if (_currentPage > 1) _currentPage--;
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages) _currentPage++;
    }

    private void ShowAttachmentsModal(LogEntry entry)
    {
        attachmentViewEntry = entry;
        showAttachmentsModal = true;
    }

    private void CloseAttachmentsModal()
    {
        showAttachmentsModal = false;
        attachmentViewEntry = null;
    }

    private static string GetAttachmentIcon(string contentType) =>
        contentType.StartsWith("image/") ? "bi-file-image" : "bi-file-earmark-pdf";

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / (1024 * 1024)} MB";
    }

    private IEnumerable<LogEntry> ApplySort(IEnumerable<LogEntry> entries)
    {
        return sortColumn switch
        {
            nameof(LogEntry.Date) => sortAscending
                ? entries.OrderBy(e => e.Date)
                : entries.OrderByDescending(e => e.Date),
            "Vehicle" => sortAscending
                ? entries.OrderBy(e => e.Vehicle?.Make).ThenBy(e => e.Vehicle?.Model)
                : entries.OrderByDescending(e => e.Vehicle?.Make).ThenByDescending(e => e.Vehicle?.Model),
            nameof(LogEntry.Description) => sortAscending
                ? entries.OrderBy(e => e.Description)
                : entries.OrderByDescending(e => e.Description),
            nameof(LogEntry.Type) => sortAscending
                ? entries.OrderBy(e => e.Type)
                : entries.OrderByDescending(e => e.Type),
            nameof(LogEntry.Cost) => sortAscending
                ? entries.OrderBy(e => e.Cost)
                : entries.OrderByDescending(e => e.Cost),
            "Reading" => sortAscending
                ? entries.OrderBy(e => e.SpeedometerReading)
                : entries.OrderByDescending(e => e.SpeedometerReading),
            nameof(LogEntry.Notes) => sortAscending
                ? entries.OrderBy(e => e.Notes)
                : entries.OrderByDescending(e => e.Notes),
            _ => entries
        };
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column)
            return "bi-chevron-expand";
        return sortAscending ? "bi-chevron-up" : "bi-chevron-down";
    }
}
