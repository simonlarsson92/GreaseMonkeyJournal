@page "/settings"
@using GreaseMonkeyJournal.Api.Components.Models
@using GreaseMonkeyJournal.Api.Components.Services
@inject IUserSettingsService UserSettingsService
@inject INotificationSettingsService NotificationSettingsService
@inject INotificationDispatcherService NotificationDispatcher
@inject IWebHostEnvironment HostEnvironment
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Settings - Grease Monkey Journal</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-lg-8 mx-auto">

            @* Display Settings *@
            <div class="card fade-in mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-currency-exchange me-2"></i>Display Settings</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="this" OnValidSubmit="SaveCurrencyAsync">
                        <div class="mb-3">
                            <label for="currencyCode" class="form-label">Currency for costs</label>
                            <select id="currencyCode" class="form-select" @bind="currencyCode">
                                @foreach (var currency in CurrencyOptions)
                                {
                                    <option value="@currency.Code">@currency.Label</option>
                                }
                            </select>
                            <div class="form-text">This currency is used when showing maintenance and repair costs.</div>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Display Settings</button>
                    </EditForm>
                </div>
            </div>

            @* Email Notification Settings *@
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-envelope me-2"></i>Email Notification Settings</h5>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (notificationSettings != null)
                    {
                        <EditForm Model="notificationSettings" OnValidSubmit="SaveEmailSettingsAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <h5 class="border-bottom pb-2">Email Configuration</h5>
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email Address</label>
                                    <InputText id="email" class="form-control" @bind-Value="notificationSettings.UserEmail"
                                               placeholder="your-email@example.com" />
                                    <ValidationMessage For="@(() => notificationSettings.UserEmail)" class="text-danger" />
                                    <div class="form-text">This email will receive maintenance reminder notifications</div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="border-bottom pb-2">Notification Preferences</h5>

                                <div class="form-check form-switch mb-3">
                                    <InputCheckbox id="isEnabled" class="form-check-input" @bind-Value="notificationSettings.IsEnabled" />
                                    <label class="form-check-label" for="isEnabled">
                                        <strong>Enable Email Notifications</strong>
                                        <div class="form-text">Master switch for all email notifications</div>
                                    </label>
                                </div>

                                @if (notificationSettings.IsEnabled)
                                {
                                    <div class="ms-4 border-start ps-3">
                                        <div class="form-check form-switch mb-3">
                                            <InputCheckbox id="send7Day" class="form-check-input" @bind-Value="notificationSettings.Send7DayReminders" />
                                            <label class="form-check-label" for="send7Day">
                                                Reminders due in <strong>7 days</strong>
                                                <div class="form-text">Get notified a week in advance</div>
                                            </label>
                                        </div>

                                        <div class="form-check form-switch mb-3">
                                            <InputCheckbox id="send1Day" class="form-check-input" @bind-Value="notificationSettings.Send1DayReminders" />
                                            <label class="form-check-label" for="send1Day">
                                                Reminders due in <strong>1 day</strong>
                                                <div class="form-text">Get notified the day before</div>
                                            </label>
                                        </div>

                                        <div class="form-check form-switch mb-3">
                                            <InputCheckbox id="sendToday" class="form-check-input" @bind-Value="notificationSettings.SendTodayReminders" />
                                            <label class="form-check-label" for="sendToday">
                                                Reminders due <strong>today</strong>
                                                <div class="form-text">Get notified on the due date</div>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Note:</strong> Notifications are sent daily at 7:00 AM. Make sure to configure the SMTP settings
                                in your environment variables for email delivery to work.
                            </div>

                            @if (!string.IsNullOrEmpty(message))
                            {
                                <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
                                    <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                                    @message
                                    <button type="button" class="btn-close" @onclick="ClearMessage"></button>
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="bi bi-save me-2"></i>Save Notification Settings
                                </button>
                            </div>
                        </EditForm>

                        <div class="mt-4 text-muted small">
                            <p class="mb-1"><strong>Last Updated:</strong> @notificationSettings.UpdatedAt.ToLocalTime().ToString("g")</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header" style="cursor: pointer;" @onclick="ToggleHelpSection">
                    <h5 class="mb-0">
                        <i class="bi bi-question-circle me-2"></i>SMTP Configuration Help
                        <i class="bi @(isHelpCollapsed ? "bi-chevron-down" : "bi-chevron-up") float-end"></i>
                    </h5>
                </div>
                @if (!isHelpCollapsed)
                {
                <div class="card-body">
                    <h6>Gmail Setup:</h6>
                    <ol>
                        <li>Enable 2-Step Verification in your Google Account</li>
                        <li>Generate an App Password at <a href="https://myaccount.google.com/apppasswords" target="_blank">myaccount.google.com/apppasswords</a></li>
                        <li>Use these settings in your .env file:
                            <ul class="mt-2">
                                <li><code>SMTP_HOST=smtp.gmail.com</code></li>
                                <li><code>SMTP_PORT=587</code></li>
                                <li><code>SMTP_USERNAME=your-email@gmail.com</code></li>
                                <li><code>SMTP_PASSWORD=your-app-password</code></li>
                            </ul>
                        </li>
                    </ol>

                    <h6 class="mt-3">Outlook/Hotmail Setup:</h6>
                    <ol>
                        <li>Use these settings in your .env file:
                            <ul class="mt-2">
                                <li><code>SMTP_HOST=smtp-mail.outlook.com</code></li>
                                <li><code>SMTP_PORT=587</code></li>
                                <li><code>SMTP_USERNAME=your-email@outlook.com</code></li>
                                <li><code>SMTP_PASSWORD=your-password</code></li>
                            </ul>
                        </li>
                    </ol>
                </div>
                }
            </div>
        </div>
    </div>

    @if (HostEnvironment.IsDevelopment())
    {
        <div class="row mt-4">
            <div class="col-lg-8 mx-auto">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-bug me-2"></i>Developer Tools</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            These tools are only visible in the <strong>Development</strong> environment.
                            Use them to test email notifications without waiting for the scheduled 7 AM dispatch.
                        </p>
                        <button class="btn btn-warning" @onclick="TriggerNotificationsNow" disabled="@isTriggeringNotifications">
                            @if (isTriggeringNotifications)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-send me-2"></i>
                            }
                            Send Test Notifications Now
                        </button>

                        @if (!string.IsNullOrEmpty(triggerMessage))
                        {
                            <div class="alert @(triggerSuccess ? "alert-success" : "alert-danger") mt-3 mb-0">
                                <i class="bi @(triggerSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                                @triggerMessage
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showCurrencySaved)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="() => showCurrencySaved = false"></button>
            </div>
            <div class="toast-body">Display settings saved.</div>
        </div>
    </div>
}

@code {
    // --- Currency settings ---
    private string currencyCode = "USD";
    private bool showCurrencySaved;

    private static readonly List<CurrencyOption> CurrencyOptions =
    [
        new("USD", "USD ($)"),
        new("EUR", "EUR (\u20ac)"),
        new("GBP", "GBP (\u00a3)"),
        new("SEK", "SEK (kr)")
    ];

    // --- Notification settings ---
    private NotificationSettings? notificationSettings;
    private bool isLoading = true;
    private bool isSaving = false;
    private string message = string.Empty;
    private bool isSuccess = false;
    private bool isHelpCollapsed = true;

    // Dev trigger state
    private bool isTriggeringNotifications = false;
    private string triggerMessage = string.Empty;
    private bool triggerSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
        await LoadHelpCollapseState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        currencyCode = await UserSettingsService.GetCurrencyCodeAsync();
        StateHasChanged();
    }

    private async Task SaveCurrencyAsync()
    {
        await UserSettingsService.SetCurrencyCodeAsync(currencyCode);
        showCurrencySaved = true;
        StateHasChanged();
        await Task.Delay(2500);
        showCurrencySaved = false;
        StateHasChanged();
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            notificationSettings = await NotificationSettingsService.GetOrCreateDefaultAsync();
        }
        catch (Exception ex)
        {
            message = $"Error loading settings: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveEmailSettingsAsync()
    {
        if (notificationSettings == null) return;

        isSaving = true;
        message = string.Empty;

        try
        {
            await NotificationSettingsService.SaveAsync(notificationSettings);
            message = "Notification settings saved successfully!";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Error saving settings: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ClearMessage()
    {
        message = string.Empty;
    }

    private async Task LoadHelpCollapseState()
    {
        try
        {
            var collapsedValue = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "settingsHelpCollapsed");
            isHelpCollapsed = collapsedValue == "true";
        }
        catch
        {
            isHelpCollapsed = true;
        }
    }

    private async Task ToggleHelpSection()
    {
        isHelpCollapsed = !isHelpCollapsed;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "settingsHelpCollapsed", isHelpCollapsed);
    }

    private async Task TriggerNotificationsNow()
    {
        isTriggeringNotifications = true;
        triggerMessage = string.Empty;

        try
        {
            var count = await NotificationDispatcher.SendRemindersAsync();
            triggerMessage = count > 0
                ? $"Done! Sent {count} email(s). Check MailDev at http://localhost:1080 to inspect them."
                : "Dispatch ran but no emails were sent. Make sure notifications are enabled and there are active reminders.";
            triggerSuccess = true;
        }
        catch (Exception ex)
        {
            triggerMessage = $"Dispatch failed: {ex.Message}";
            triggerSuccess = false;
        }
        finally
        {
            isTriggeringNotifications = false;
        }
    }

    private record CurrencyOption(string Code, string Label);
}
